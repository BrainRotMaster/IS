;; templates.clp
;; Здесь задаём "структуры" фактов и начальный ioproxy

;; Факт-посредник для общения с C#-GUI
(deftemplate ioproxy
  (multislot messages)  ; список строк для пользователя
  (multislot answers))  ; список допустимых ответов

;; Факт "симптом" — просто id из твоей БЗ (f1, f8, f31 и т.п.)
(deftemplate have
  (slot id))

;; Факт "диагноз" — текст, который покажем пользователю
(deftemplate diagnosis
  (slot text))

;; Факт "что уже спрашивали" — чтобы понимать,
;; на какой вопрос пользователь сейчас отвечает
(deftemplate asked
  (slot id))

;; Стартовые факты — приветствие
(deffacts start
  (ioproxy
    (messages
      "Здравствуйте! Это экспертная система для диагностики проблем ПК."
      "Я задам вам несколько вопросов о симптомах вашего компьютера."
      "Нажмите «Дальше» или скажите «начать», чтобы начать.")
    (answers start)))
