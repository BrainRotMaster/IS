;; Правила формирования диагнозов из терминальных фактов

(defrule diagnose-f122
  (have (id f122))
=>
  (assert (diagnosis (text "Запах гари и риск отказа диска (f82) усиливают вероятность серьёзного аппаратного повреждения (f122).")))
)

(defrule diagnose-f123
  (have (id f123))
=>
  (assert (diagnosis (text "Нестабильное напряжение и перегрузка дисковой подсистемы (f83) указывают на риск потери данных и сбоев загрузки (f123).")))
)

(defrule diagnose-f124
  (have (id f124))
=>
  (assert (diagnosis (text "Перегрев видеокарты и проблемы с дисковой/процессорной подсистемой (f84) усиливают гипотезу о комплексной аппаратной проблеме (f124).")))
)

(defrule diagnose-f125
  (have (id f125))
=>
  (assert (diagnosis (text "Пыль и критическое состояние системного диска (f85) указывают на высокий риск отказа и перегрева (f125).")))
)

(defrule diagnose-f126
  (have (id f126))
=>
  (assert (diagnosis (text "Очень горячий радиатор и серьёзные программные/системные сбои (f86) указывают на тяжёлую проблему охлаждения и ОС (f126).")))
)

(defrule diagnose-f127
  (have (id f127))
=>
  (assert (diagnosis (text "Отсутствие сигнала на мониторе и перегруженная система (f87) усиливают гипотезу о комплексной проблеме ОС и железа (f127).")))
)

(defrule diagnose-f128
  (have (id f128))
=>
  (assert (diagnosis (text "Сбои драйвера видеокарты и старый/ненадёжный диск (f88) указывают на высокий риск аппаратных сбоев (f128).")))
)

(defrule diagnose-f129
  (have (id f129))
=>
  (assert (diagnosis (text "Старая видеокарта и перегрев накопителя (f89) усиливают подозрение на «усталость» системы и риск отказа (f129).")))
)

(defrule diagnose-f130
  (have (id f130))
=>
  (assert (diagnosis (text "Писк видеокарты и серьёзные проблемы с дисковой подсистемой (f90) указывают на комплексный аппаратный сбой (f130).")))
)

(defrule diagnose-f132
  (have (id f132))
=>
  (assert (diagnosis (text "Совокупность сильных признаков перегрева и возможного аппаратного повреждения видеокарты указывает на серьёзную неисправность видеоподсистемы (диагноз f132).")))
)

(defrule diagnose-f133
  (have (id f133))
=>
  (assert (diagnosis (text "Накопление симптомов нестабильного питания и системной нестабильности (f93, f97) приводит к диагнозу о серьёзных проблемах блока питания (f133).")))
)

(defrule diagnose-f135
  (have (id f135))
=>
  (assert (diagnosis (text "Признаки перегрева и деградации дисковой подсистемы (f95, f103) указывают на серьёзную неисправность накопителя (диагноз f135).")))
)

(defrule diagnose-f136
  (have (id f136))
=>
  (assert (diagnosis (text "Сочетание сильного перегрева и общей программно-аппаратной нестабильности (f96, f106) приводит к диагнозу о серьёзной системной проблеме (f136).")))
)

(defrule diagnose-f138
  (have (id f138))
=>
  (assert (diagnosis (text "Сбои видеоподсистемы и риски повреждения данных/диска (f98, f112) указывают на комплексную аппаратную неисправность (диагноз f138).")))
)

(defrule diagnose-f139
  (have (id f139))
=>
  (assert (diagnosis (text "Признаки деградации видеокарты и подтверждение, что проблема не в мониторе (f99, f115), приводят к диагнозу аппаратной неисправности видеокарты (f139).")))
)

(defrule diagnose-f141
  (have (id f141))
=>
  (assert (diagnosis (text "Деградация накопителя и комплексные проблемы запуска/видеовывода (f101, f121) приводят к диагнозу о тяжёлых неисправностях хранения и загрузки (f141).")))
)

(defrule diagnose-f142
  (have (id f142))
=>
  (assert (diagnosis (text "Нестабильная работа ОС и серьёзные проблемы видеокарты (f102, f94) указывают на сложный программно-аппаратный конфликт (диагноз f142).")))
)

(defrule diagnose-f144
  (have (id f144))
=>
  (assert (diagnosis (text "Перегрузка и перегрев системы (f104) вместе с серьёзными проблемами питания/видео (f100) указывают на комплексный аппаратный сбой (диагноз f144).")))
)

(defrule diagnose-f145
  (have (id f145))
=>
  (assert (diagnosis (text "Ошибки ОС после обновлений и признаки деградации диска (f105, f103) приводят к диагнозу о повреждении системного накопителя (f145).")))
)

(defrule diagnose-f147
  (have (id f147))
=>
  (assert (diagnosis (text "Тяжёлые проблемы с запуском и явные признаки неисправности блока питания (f107, f109) приводят к диагнозу критического сбоя БП (f147).")))
)

(defrule diagnose-f148
  (have (id f148))
=>
  (assert (diagnosis (text "Сильная нестабильность питания и риски повреждения данных/диска (f108, f112) указывают на серьёзную проблему БП и накопителя (диагноз f148).")))
)

(defrule diagnose-f150
  (have (id f150))
=>
  (assert (diagnosis (text "Нестабильное/опасное питание и сильные признаки проблем видеокарты (f110, f118) указывают на комплексный сбой питания и видеоподсистемы (диагноз f150).")))
)

(defrule diagnose-f151
  (have (id f151))
=>
  (assert (diagnosis (text "Серьёзные проблемы видеокарты и сложные проблемы запуска/отображения (f111, f121) приводят к диагнозу тяжёлой видеонесправности (f151).")))
)

(defrule diagnose-f153
  (have (id f153))
=>
  (assert (diagnosis (text "Серьёзные системные сбои и общая нестабильность (f113, f97) приводят к диагнозу комплексной системной неисправности (f153).")))
)

(defrule diagnose-f154
  (have (id f154))
=>
  (assert (diagnosis (text "Аппаратные проблемы видеокарты и питания под нагрузкой (f114, f100) указывают на тяжёлый сбой видеоподсистемы (диагноз f154).")))
)

(defrule diagnose-f156
  (have (id f156))
=>
